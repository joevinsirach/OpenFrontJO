{
  "name": "openfront-jo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron wrapper that loads the OpenFrontJO client. Read-only shell: it does not speak for the player.",
  "main": "dist/main.js",
  "author": "OpenFrontJO",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron . --dev",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "ejs": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  }
}
